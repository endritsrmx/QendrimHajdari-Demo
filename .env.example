# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.example.com          # production domain, no trailing slash
ALLOW_INDEXING=false                                  # set true on production (Vercel uses VERCEL_ENV automatically)
ENABLE_HSTS=false                                     # true only on the production HTTPS domain

# ─── Editorial workflow ───────────────────────────────────────────────
# true  = show draft / needs_medical_review content with visible badges (staging, client review)
# false = only approved / published content (production)
NEXT_PUBLIC_CONTENT_PREVIEW=false
NEXT_PUBLIC_RESULTS_PUBLISHED=false                   # only after legal + medical + data-protection approval
NEXT_PUBLIC_TESTIMONIALS_PUBLISHED=false              # only with documented patient consent

# ─── Verified contact data ([PHONE_NUMBER], [BUSINESS_EMAIL], addresses) ─
NEXT_PUBLIC_PRACTICE_PHONE=
NEXT_PUBLIC_PRACTICE_EMAIL=
NEXT_PUBLIC_ROYAL_MEDICAL_ADDRESS=
NEXT_PUBLIC_ROYAL_MEDICAL_PHONE=
NEXT_PUBLIC_ROYAL_MEDICAL_MAPS_URL=
NEXT_PUBLIC_DORA_ADDRESS=
NEXT_PUBLIC_DORA_PHONE=
NEXT_PUBLIC_DORA_MAPS_URL=

# ─── Booking (Cal.com) – [BOOKING_PROVIDER_ACCOUNT] ───────────────────
# Cal link per location: "<username-or-team>/<event-type-slug>"
NEXT_PUBLIC_CALCOM_LINK_ROYAL_MEDICAL=
NEXT_PUBLIC_CALCOM_LINK_DORA=
NEXT_PUBLIC_CALCOM_ORIGIN=https://cal.com
NEXT_PUBLIC_CALCOM_EMBED_ORIGIN=https://app.cal.com
NEXT_PUBLIC_CALCOM_EMBED_JS_URL=https://app.cal.com/embed/embed.js

# ─── Contact form e-mail (server only – never prefix with NEXT_PUBLIC_) ─
CONTACT_EMAIL_PROVIDER=                               # "resend" to enable
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=                                   # e.g. "Website <website@your-domain.com>" (verified domain)
